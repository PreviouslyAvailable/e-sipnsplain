{
  "name": "ps2ui",
  "version": "0.1.0",
  "description": "PS2UI — the PlayStation 2 system dashboard rebuilt as a TypeScript/React UI kit for the web. The boot screen, the floating data-cubes, the Emotion-Engine blue. Works great in Next.js.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/Timmy-Lane/ps2ui#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Timmy-Lane/ps2ui.git"
  },
  "keywords": [
    "playstation",
    "ps2",
    "react",
    "nextjs",
    "typescript",
    "ui-kit",
    "components",
    "retro",
    "design-system",
    "y2k"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles/ps2ui.css",
    "./tokens.css": "./dist/tokens/variables.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "tsup && tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "typecheck": "tsc --noEmit",
    "demo:build": "next build",
    "demo:start": "next start"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
